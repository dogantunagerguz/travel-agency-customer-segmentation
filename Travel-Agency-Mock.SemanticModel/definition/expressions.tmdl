		    Oteller_Sheet = Source{[Item="Oteller",Kind="Sheet"]}[Data],
		    #"Promoted Headers" = Table.PromoteHeaders(Oteller_Sheet, [PromoteAllScalars=true]),
		    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"Otel Adı", type text}, {"Ülke", type text}, {"Şehir", type text}, {"İlçe", type text}, {"Oda Sınıfı", type text}, {"Otel Sınıfı", type text}, {"Ort. 2 Kişilik Oda Fiyatı (₺)", type number}, {"Ort. 3 Kişilik Oda Fiyatı (₺)", type number}, {"Ort. 4 Kişilik Oda Fiyatı (₺)", type number}, {"Ort. Tek Kişilik Oda Fiyatı (₺)", type number}, {"Acente", type text}}),
		    #"Removed Other Columns" = Table.SelectColumns(#"Changed Type",{"Otel Adı", "Ülke", "Şehir", "İlçe", "Otel Sınıfı", "Acente"}),
		    #"Removed Duplicates" = Table.Distinct(#"Removed Other Columns", {"Otel Adı"}),
