/// Folder created by scripts/setup_demo.py; configurable in Manage Parameters.
expression DemoDataFolder = "" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	annotation PBI_ResultType = Text

expression 'Ets Otelleri' =
		let
		    Source = Excel.Workbook(File.Contents(DemoDataFolder & "/Etstur_Otel_Sinif.xlsx"), null, true),
		    Oteller_Sheet = Source{[Item="Oteller",Kind="Sheet"]}[Data],
		    #"Changed Type" = Table.TransformColumnTypes(Oteller_Sheet,{{"Column1", type text}, {"Column2", type text}, {"Column3", type text}, {"Column4", type text}, {"Column5", type text}}),
		    #"Promoted Headers" = Table.PromoteHeaders(#"Changed Type", [PromoteAllScalars=true]),
		    #"Changed Type1" = Table.TransformColumnTypes(#"Promoted Headers",{{"Otel Adı", type text}, {"Ülke", type text}, {"Şehir", type text}, {"İlçe", type text}, {"Otel Sınıfı", type text}}),
		    #"Added Custom" = Table.AddColumn(#"Changed Type1", "Acente", each "Etstur")
		in
		    #"Added Custom"
	lineageTag: 804f69b4-3caa-4923-bc68-f244ef8ee8b9

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression 'Didim Otelleri' =
