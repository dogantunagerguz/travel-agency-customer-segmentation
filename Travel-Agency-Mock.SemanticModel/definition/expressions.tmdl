		    Source = Excel.Workbook(File.Contents(DemoDataFolder & "/Travel-Mock.xlsx"), null, true),
		    Rezervasyonlar_Sheet = Source{[Item="Rezervasyonlar",Kind="Sheet"]}[Data],
		    #"Promoted Headers" = Table.PromoteHeaders(Rezervasyonlar_Sheet, [PromoteAllScalars=true]),
		    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"No", Int64.Type}, {"Rez.No", Int64.Type}, {"Kabul", type text}, {"Ad Soyad", type text}, {"Yaş", Int64.Type}, {"Otel", type text}, {"Geliş", Int64.Type}, {"Ayrılış", Int64.Type}, {"Gece", Int64.Type}, {"Toplam", type number}, {"Ödenen", type number}, {"Bakiye", type number}, {"Yetişkin", Int64.Type}, {"Çocuk", Int64.Type}, {"Düşünceler", type text}}),
