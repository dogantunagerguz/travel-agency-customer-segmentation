	column 'Geliş (bins)' =
			IF(
				ISBLANK('Reservations'[Geliş]),
				BLANK(),
				DATE(
					YEAR('Reservations'[Geliş]),
					1 + (MONTH('Reservations'[Geliş]) - 1),
					1
				)
			)
		formatString: mmmm yyyy
		lineageTag: e7560777-6909-49a9-8672-3f8492b7e0d0
		summarizeBy: none

