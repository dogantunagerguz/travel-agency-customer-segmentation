	column Çocuk
		dataType: int64
		formatString: 0
		lineageTag: 8b087808-7ee8-4695-9544-38250935c807
		summarizeBy: sum
		sourceColumn: Çocuk

		annotation SummarizationSetBy = Automatic

	column 'Customer Segment' = ```
			
			VAR CurrentYear = 2026
			VAR PreviousY = CurrentYear - 1
			
			-- ALLEXCEPT drops the row-level filter so the count runs across the whole
			-- Rezervasyonlar table for this customer name only, not just the current row.
			VAR CurrentSeasonPurchases = 
			    CALCULATE(
			        COUNTROWS(Reservations),
			        ALLEXCEPT(Reservations, Reservations[Ad Soyad]),
			        Calendar[Yıl] = CurrentYear
			    )
			
			VAR PreviousSeasonPurchases = 
			    CALCULATE(
			        COUNTROWS(Reservations),
			        ALLEXCEPT(Reservations, Reservations[Ad Soyad]),
			        Calendar[Yıl] = PreviousY
			    )
			
			VAR OlderPurchases = 
			    CALCULATE(
			        COUNTROWS(Reservations),
			        ALLEXCEPT(Reservations, Reservations[Ad Soyad]),
			        Calendar[Yıl] < PreviousY
			    )
			
			-- Treat missing counts as 0
			VAR NetCurrentSeason = COALESCE(CurrentSeasonPurchases, 0)
			VAR NetPreviousSeason = COALESCE(PreviousSeasonPurchases, 0)
			VAR NetOlder = COALESCE(OlderPurchases, 0)
			
			-- Total past purchases (excluding the current season)
			VAR TotalPastPurchases = NetPreviousSeason + NetOlder
			
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(Reservations[Ad Soyad]), BLANK(),
			    
			    -- New: purchased this season, never before
			    TotalPastPurchases = 0, "New",
			    
			    -- Loyal: purchased both this season and last season
			    NetCurrentSeason > 0 && NetPreviousSeason > 0, "Loyal",
			    
			    -- One-time: no purchase this season, exactly 1 in the past overall
			    NetCurrentSeason = 0 && TotalPastPurchases = 1, "One-time",
			    
			    -- Lapsed: no purchase this season, more than one in the past
			    NetCurrentSeason = 0 && TotalPastPurchases > 1, "Lapsed",
			    
			    -- Won back: skipped last season but bought in older years and returned this year
			    NetCurrentSeason > 0 && NetPreviousSeason = 0 && NetOlder > 0, "Won back",
			    
			    "Other")
			```
		lineageTag: e1a3954c-339d-42a0-8f9b-2c7c0161bc48
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column On_Alim_Suresi = DATEDIFF(Reservations[İşlem Tarihi], Reservations[Geliş], DAY)
		formatString: 0
		lineageTag: f155d45a-366a-44bc-a7ff-20424a43fcee
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Family Type' = ```
			
			
			SWITCH(
			    TRUE(),
			    ISBLANK(Reservations[Ad Soyad]), BLANK(),
			    
			    -- 1. Couple: exactly two adults, no children
			    Reservations[Yetişkin] = 2 && Reservations[Çocuk] = 0, "Couple",
			    -- 2. Family with children: two adults and at least one child
			    Reservations[Yetişkin] = 2 && Reservations[Çocuk] >= 1, "Family with children",
			    -- 3. More than two adults
			    Reservations[Yetişkin] > 2 && Reservations[Çocuk] >= 0, "Other",
			    -- 4. Single: one person, no children
			    Reservations[Yetişkin] = 1 && Reservations[Çocuk] = 0, "Single",
			
			    "Other")
			```
		lineageTag: fab968f2-8764-4137-9851-3234de22c976
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Age Group' =
			
			SWITCH(
			    TRUE(),
			    Reservations[Yaş] <= 25, "18-25",
			    Reservations[Yaş] <= 35, "26-35",
			    Reservations[Yaş] <= 50, "36-50",
			    "51+"
			)
		lineageTag: 4fcf9f9a-cb02-4b3f-86b8-c78941110596
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

