	column 'Bugünden Ay Farkı'
		formatString: 0
		lineageTag: e02fff2b-e927-40db-9f37-453c128009f5
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Bugünden Ay Farkı]

		annotation SummarizationSetBy = Automatic

	partition Calendar = calculated
		mode: import
		source =
				
				VAR _StartDate = DATE(2010, 1, 1)
				VAR _EndDate   = DATE(2035, 12, 31)
				RETURN
				ADDCOLUMNS(
				    CALENDAR(_StartDate, _EndDate),
				    "Yıl",                YEAR([Date]),
				    "Ay No",              MONTH([Date]),
				    "Ay",                 FORMAT([Date], "MMMM", "en-US"),
				    "Ay Kısa",            FORMAT([Date], "MMM", "en-US"),
				    "Ay Yıl",             FORMAT([Date], "MMM yyyy", "en-US"),
				    "Yıl-Ay (Sıralama)",  YEAR([Date]) * 100 + MONTH([Date]),
				    "Çeyrek",             "Q" & FORMAT([Date], "Q"),
				    "Yıl Çeyrek",         FORMAT([Date], "yyyy") & " Q" & FORMAT([Date], "Q"),
				    "Hafta Günü No",      WEEKDAY([Date], 2),
				    "Hafta Günü",         FORMAT([Date], "dddd", "en-US"),
				    "Geçmiş/Gelecek",     SWITCH(TRUE(),
				                              [Date] < TODAY(), "Geçmiş",
				                              [Date] = TODAY(), "Bugün",
				                              "Gelecek"),
				    "Bu Ay mı",           IF(YEAR([Date]) = YEAR(TODAY()) && MONTH([Date]) = MONTH(TODAY()), "Evet", "Hayır"),
				    "Bu Yıl mı",          IF(YEAR([Date]) = YEAR(TODAY()), "Evet", "Hayır"),
				    "Bugünden Ay Farkı",  DATEDIFF(TODAY(), [Date], MONTH)
				)

	annotation PBI_Id = bd9ddebafbce43fdb71ad98bce37966f

